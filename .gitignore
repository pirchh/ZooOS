# Cargo output (host tool and kernel builds)
/target/
# Generated boot images, per-run firmware variable stores and serial logs
/build/
# Local firmware/QEMU copies, if a developer keeps them in the tree
/tools/firmware/*.fd

# Downloaded model weights (see tools/models/README.md)
/tools/models/*.gguf
/tools/models/*.part
/tools/models/.pending-commit

# Python reference environment (tools/reference/README.md)
/tools/reference/.venv/

# C toolchain (downloaded; see tools/zig/README.md)
/tools/zig/*/
/tools/zig/*.zip

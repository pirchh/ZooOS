# Cargo output (host tool and kernel builds)
/target/
# Generated boot images, per-run firmware variable stores and serial logs
/build/
# Local firmware/QEMU copies, if a developer keeps them in the tree
/tools/firmware/*.fd

# Downloaded model weights (see tools/models/README.md)
/tools/models/*.gguf
/tools/models/*.part
/tools/models/.pending-commit

# Python reference environment (tools/reference/README.md)
/tools/reference/.venv/

# C toolchain (downloaded; see tools/zig/README.md)
/tools/zig/*/
/tools/zig/*.zip

# musl source for the dynamic loader (downloaded; see tools/musl/README.md)
/tools/musl/*/
/tools/musl/*.tar.gz
/tools/musl/*.asc

# Inter (downloaded; see tools/fonts/README.md)
/tools/fonts/dl/
/tools/fonts/inter-*/

# Wine build inputs (downloaded; see tools/alpine/README.md, tools/wine/README.md)
/tools/alpine/*.tar.gz*
/tools/wine/*.tar.xz*
/tools/wine/*/
# Downloaded voice models (see tools/models/README.md, "Voice")
/tools/models/voice/**
!/tools/models/voice/*.sha256
